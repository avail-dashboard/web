# Avail Explorer Production Environment Configuration
# Copy this file to .env.production and modify values as needed
# This file centralizes all environment variables for production deployment

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.avail.naxatar.com/api
NEXT_PUBLIC_WS_URL=wss://api.avail.naxatar.com
NEXT_PUBLIC_NODE_ENV=production

# Application Configuration
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Docker Configuration
FRONTEND_PORT=3000

# Optional: Analytics and Monitoring
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id 